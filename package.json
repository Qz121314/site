{
  "name": "cloudflare-service-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @site/storefront --filter @site/admin --filter @site/worker run dev",
    "build": "pnpm cf:types && pnpm run build:apps && node scripts/assemble-assets.mjs",
    "build:apps": "pnpm --filter @site/storefront build && pnpm --filter @site/admin build && pnpm --filter @site/worker build",
    "lint": "eslint .",
    "typecheck": "pnpm cf:types && pnpm -r --if-present typecheck",
    "test": "node --input-type=module -e \"import{spawnSync}from'node:child_process';const r=spawnSync('pnpm',['-r','--if-present','test'],{encoding:'utf8'});process.stdout.write(r.stdout||'');process.stderr.write(r.stderr||'');if(r.status){const s=(r.stdout||'')+'\\n'+(r.stderr||'');const a=s.split(/\\r?\\n/);let i=a.findIndex(x=>/not ok|AssertionError|ERR_ASSERTION/.test(x));if(i<0)i=Math.max(0,a.length-40);const e=a.slice(Math.max(0,i-8),i+35).join('\\n');console.log('::error title=Test failure excerpt::'+Buffer.from(e).toString('base64'));process.exit(r.status)}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "cf:types": "wrangler types apps/worker/src/worker-configuration.d.ts",
    "cf:check": "wrangler deploy --dry-run",
    "db:migrations:list": "wrangler d1 migrations list DB --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.20.0"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "service-catalog-site",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/go/*",
      "/public/*",
      "!/sections/*",
      "!/products/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "service-catalog-site-db",
      "database_id": "b4282664-c690-4a38-9b2e-32e902c51442",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "service-catalog-site-assets"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "0.1.0"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

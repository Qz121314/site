{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "service-catalog-site-dev",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api/*", "/go/*"]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_VERSION": "0.1.0"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "service-catalog-site-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "APP_VERSION": "0.1.0"
      }
    },
    "production": {
      "name": "service-catalog-site",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "0.1.0"
      }
    }
  }
}
